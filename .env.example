# Sunucu ortam değişkenleri. İstemci paketine gömülmez. Değerleri repoya yazmayın.

# İsteğe bağlı. Yoksa Finnhub modülü devre dışı kalır.
FINNHUB_API_KEY=

# İsteğe bağlı. Yoksa ABD para arzı / likidite paneli "anahtar gerekli" der.
FRED_API_KEY=

# İsteğe bağlı. Yoksa Türkiye EVDS paneli "anahtar gerekli" der.
EVDS_API_KEY=

# EVDS Tüm Seriler ekranındaki resmi seri kodu. Kod repoda uydurulmaz.
EVDS_M2_SERIES=
